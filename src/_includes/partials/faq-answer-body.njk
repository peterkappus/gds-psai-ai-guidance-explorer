{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

<p class="govuk-body">
  <!--span class="govuk-!-display-block govuk-body-s govuk-!-margin-top-2">{{ item.category_title }}</span-->
  {{ govukTag({
    text: item.status | humanizeToken,
    classes: item.status | faqStatusTagClass
  }) }}
</p>

<p class="govuk-body-l">{{ item.answer }}</p>

{% if item.conflict %}
  <div class="app-conflict">
    {{ govukWarningText({
      text: "Conflicting or tensioned advice across sources",
      iconFallbackText: "Warning"
    }) }}
    <p class="govuk-body">{{ item.conflict.summary }}</p>
    {% if item.conflict.user_guidance %}
      <p class="govuk-body">
        <strong class="govuk-!-font-weight-bold">How to navigate this:</strong>
        {{ item.conflict.user_guidance }}
      </p>
    {% endif %}
  </div>
{% endif %}

<h2 class="govuk-heading-m">From the guidance</h2>

{% for citation in item.citations %}
  {% set citationUrl = citation | textFragmentUrl %}
  <div class="app-citation-block{% if citation.role == 'contrasting' %} app-citation-block--contrasting{% endif %}">
    <p class="govuk-body-s govuk-!-margin-bottom-2">
      {{ govukTag({
        text: citation.role | citationRoleLabel,
        classes: citation.role | citationRoleTagClass
      }) }}
        <span class="govuk-!-display-block govuk-!-font-weight-bold govuk-!-margin-top-2">{{ citation.source_title }}</span>
      {% if citation.stance %}
        <div class="govuk-body govuk-!-margin-top-5">
        <span class="govuk-!-font-weight-bold">Position:</span> {{ citation.stance }}
        </div>
      {% endif %}
    </p>

    {{ govukInsetText({
      classes: "app-snippet",
      text: citation.snippet
    }) }}

    <div class="app-citation">
      <p class="govuk-body-s">
        <strong class="govuk-!-font-weight-bold">Section:</strong>
        {{ citation.section }}
      </p>
      <p class="govuk-body">
        <a class="govuk-link" href="{{ citationUrl }}" rel="noreferrer noopener" target="_blank">
          Read this in {{ citation.source_title }} (opens in new tab)
        </a>
      </p>
    </div>
  </div>
{% endfor %}
