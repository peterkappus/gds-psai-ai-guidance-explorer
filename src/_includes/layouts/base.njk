{% from "govuk/components/skip-link/macro.njk" import govukSkipLink %}
{% from "govuk/components/generic-header/macro.njk" import govukGenericHeader %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "govuk/components/footer/macro.njk" import govukFooter %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}

<!DOCTYPE html>
<html lang="en" class="govuk-template">
  <head>
    <meta charset="utf-8">
    <title>{% if title %}{{ title }} – {% endif %}{{ site.serviceName }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="{{ description or site.description }}">
    <meta name="theme-color" content="#0b0c0c">
    <link rel="icon" href="/assets/icons/favicon.ico" sizes="any">
    <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
    <link rel="manifest" href="/assets/icons/site.webmanifest">
    <link rel="stylesheet" href="/assets/css/main.css">
    {% if site.gaMeasurementId %}
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaMeasurementId }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ site.gaMeasurementId }}');
      </script>
    {% endif %}
  </head>
  <body class="govuk-template__body">
    <script>
      document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
    </script>

    {{ govukSkipLink({
      text: "Skip to main content",
      href: "#main-content"
    }) }}

    {{ govukGenericHeader({
      logoText: site.serviceName,
      url: "/"
    }) }}

    {% set aboutIsCurrent = page.url.indexOf('/about/') === 0 %}
    {% set sourcesIsCurrent = page.url.indexOf('/sources/') === 0 %}
    {% set guidanceMapIsCurrent = page.url.indexOf('/guidance-map/') === 0 %}
    {% set questionsIsCurrent = page.url === "/" or page.url.indexOf('/faq/') === 0 %}
    {{ govukServiceNavigation({
      navigation: [
        {
          href: "/",
          text: "Questions",
          current: questionsIsCurrent
        },
        {
          href: "/sources/",
          text: "Sources",
          current: sourcesIsCurrent
        },
        {
          href: "/guidance-map/",
          text: "Guidance map",
          current: guidanceMapIsCurrent
        },
        {
          href: "/about/",
          text: "About",
          current: aboutIsCurrent
        }
      ]
    }) }}

    {% set phaseHtml %}
      This is a prototype. Answers cite UK public sector AI guidance from incorporated <a href="/sources">sources</a>.
    {% endset %}
    {{ govukPhaseBanner({
      tag: {
        text: site.phase
      },
      html: phaseHtml
    }) }}



    <div class="govuk-width-container">
      <main class="govuk-main-wrapper" id="main-content" role="main">
        {% block content %}{% endblock %}
      </main>
    </div>

    {% set footerHtml %}
      <p class="govuk-body-s">
        Prototype catalogue of UK public sector AI guidance. Not an official GOV.UK service.
        Guidance excerpts © Crown copyright, used under the
        <a class="govuk-footer__link" href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/">Open Government Licence v3.0</a>.
      </p>
    {% endset %}
    {{ govukFooter({
      navigation: [
        {
          title: "Two column list",
          width: "one-half",
          title: "Explore",
          items: [
            { href: "/", text: "Questions" },
            { href: "/sources/", text: "Sources" },
            { href: "/guidance-map/", text: "Guidance map" }
          ]
        },
        {
          title: "About",
          width: "one-half",
          items: [
            { href: "/about/", text: "About this explorer" },
            { href: "/about/process/", text: "Source lifecycle" },
            { href: "https://www.peterkappus.com/?utm_source=psai-guidance-explorer", text: "Made by Peter Kappus" }
          ]
        }
      ],
      meta: {
        visuallyHiddenTitle: "About this page",
        html: footerHtml
      },
      contentLicence: null
    }) }}

    <script type="module" src="/assets/govuk-frontend.min.js"></script>
    <script type="module">
      import { initAll } from '/assets/govuk-frontend.min.js'
      initAll()
    </script>
  </body>
</html>
