{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% set title = "Common questions about AI adoption" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ title }}</h1>
      <p class="govuk-body-l">
        Browse common questions about adopting AI in government. Each answer has its own
        page with cited snippets and deep links to the source guidance.
      </p>
      <p class="govuk-body">
        Browse the <a href="/sources">sources</a> or 
        <a href="/about">learn more about the AI Guidance Explorer.</a>
      </p>
      <p class="govuk-body-s">
        On multi-source answers, <strong class="govuk-!-font-weight-bold">Primary</strong> citations explain
        <em>how</em> to act; <strong class="govuk-!-font-weight-bold">Secondary</strong> citations explain
        whether something can, must, should, or should not be done.
      </p>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third">
      <h2 class="govuk-heading-m govuk-!-margin-top-6">Categories</h2>
      <nav class="govuk-!-margin-bottom-6" aria-label="FAQ categories">
        <ul class="govuk-list">
          {% for category in faq.categories %}
            <li>
              <a class="govuk-link" href="#{{ category.id }}">{{ category.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    <div class="govuk-grid-column-two-thirds">
      {% for category in faq.categories %}
        <section class="app-category" id="{{ category.id }}">
          <h2 class="govuk-heading-l">{{ category.title }}</h2>

          <ul class="govuk-list">
            {% for item in category.questions %}
              <li class="govuk-!-margin-bottom-4">
                <p class="govuk-body govuk-!-margin-bottom-1">
                  <a class="govuk-link govuk-!-font-weight-bold" href="{{ item.url }}">{{ item.question }}</a>
                </p>
                <p class="govuk-body-s govuk-!-margin-bottom-0">
                  {% if item.status != "answered" %}
                  {{ govukTag({
                    text: item.status | humanizeToken,
                    classes: item.status | faqStatusTagClass
                  }) }}
                  {% endif %}
                  {% if item.citations.length > 1 %}
                    <span class="govuk-!-margin-left-1">{{ item.citations.length }} sources</span>
                  {% endif %}
                </p>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endfor %}
    </div>
  </div>
{% endblock %}
