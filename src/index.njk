{% extends "layouts/base.njk" %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% set title = "Common questions about AI adoption" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ title }}</h1>
      <p class="govuk-body-l">
        Browse common questions about adopting AI in government. Answers synthesise
        incorporated guidance and show cited snippets with deep links to the source.
      </p>
      <p class="govuk-body">
        Sources currently cited include the
        <a class="govuk-link" href="{{ faq.source.url }}">{{ faq.source.title }}</a>
        and selected
        <a class="govuk-link" href="https://www.gov.uk/government/publications/ai-insights">AI Insights</a>
        articles. Where guidance differs, both positions are shown.
        <a href="/about">Learn more about the AI Guidance Explorer.</a>
      </p>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third" style="position: sticky; top: 0">
      <h2 class="govuk-heading-m govuk-!-margin-top-6">Categories</h2>
      <nav class="govuk-!-margin-bottom-6" aria-label="FAQ categories">
        <ul class="govuk-list">
          {% for category in faq.categories %}
            <li>
              <a class="govuk-link" href="#{{ category.id }}">{{ category.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    <div class="govuk-grid-column-two-thirds">
      {% for category in faq.categories %}
        <section class="app-category" id="{{ category.id }}">
          <h2 class="govuk-heading-l">{{ category.title }}</h2>

          {% for item in category.questions %}
            {% set answerHtml %}
              <p class="govuk-body">
                {{ govukTag({
                  text: item.status | humanizeToken,
                  classes: item.status | faqStatusTagClass
                }) }}
              </p>

              <p class="govuk-body">{{ item.answer }}</p>

              {% if item.conflict %}
                <div class="app-conflict">
                  {{ govukWarningText({
                    text: "Conflicting or tensioned advice across sources",
                    iconFallbackText: "Warning"
                  }) }}
                  <p class="govuk-body">{{ item.conflict.summary }}</p>
                  {% if item.conflict.user_guidance %}
                    <p class="govuk-body">
                      <strong class="govuk-!-font-weight-bold">How to navigate this:</strong>
                      {{ item.conflict.user_guidance }}
                    </p>
                  {% endif %}
                </div>
              {% endif %}

              <h3 class="govuk-heading-s">From the guidance</h3>

              {% for citation in item.citations %}
                {% set citationUrl = citation | textFragmentUrl %}
                <div class="app-citation-block{% if citation.role == 'contrasting' %} app-citation-block--contrasting{% endif %}">
                  <p class="govuk-body-s govuk-!-margin-bottom-2">
                    {{ govukTag({
                      text: citation.role | humanizeToken,
                      classes: citation.role | citationRoleTagClass
                    }) }}
                    <strong class="govuk-!-font-weight-bold">{{ citation.source_title }}</strong>
                    {% if citation.stance %}
                      <br>
                      <span class="govuk-!-font-weight-bold">Position:</span> {{ citation.stance }}
                    {% endif %}
                  </p>

                  {{ govukInsetText({
                    classes: "app-snippet",
                    text: citation.snippet
                  }) }}

                  <div class="app-citation">
                    <p class="govuk-body-s">
                      <strong class="govuk-!-font-weight-bold">Section:</strong>
                      {{ citation.section }}
                    </p>
                    <p class="govuk-body">
                      <a class="govuk-link" href="{{ citationUrl }}" rel="noreferrer noopener" target="_blank">
                        Read this in {{ citation.source_title }} (opens in new tab)
                      </a>
                    </p>
                  </div>
                </div>
              {% endfor %}
            {% endset %}

            {{ govukDetails({
              summaryText: item.question,
              html: answerHtml
            }) }}
          {% endfor %}
        </section>
      {% endfor %}
    </div>
  </div>
{% endblock %}
